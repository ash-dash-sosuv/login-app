# DOMAIN comes from docker-compose (e.g. 13-233-10-20.sslip.io). Caddy obtains
# and renews the Let's Encrypt certificate for it automatically.
{$DOMAIN} {
	encode gzip
	reverse_proxy app:5000
}

# F1 stats site: static files uploaded to ./f1-site on the server (see
# deploy-f1.sh in the F1_2026 project). F1_DOMAIN defaults to f1.<DOMAIN>.
{$F1_DOMAIN} {
	encode zstd gzip
	root * /srv/f1
	file_server

	# Vite gives built JS/CSS hashed names, so they can be cached for good.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"
}
