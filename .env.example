# Copy to .env and fill in real values for local development.
# In production, set these as real environment variables (do NOT commit .env).

# Long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# --- Database ---------------------------------------------------------------
# The app selects its database from DATABASE_URL if set, otherwise it falls
# back to a local SQLite file (DATABASE below).
#
# Postgres (production). Render/Heroku inject DATABASE_URL automatically; the
# app accepts postgres://, postgresql://, or postgresql+psycopg:// forms.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
#
# SQLite (local dev default). Only used when DATABASE_URL is unset.
DATABASE=users.db

# --- Email OTP (optional) ---------------------------------------------------
# Used to send login codes by email when the user picks "Email OTP". When
# SMTP_HOST is unset, codes are printed to the server console instead, so local
# development works without a real email account.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@example.com

# --- SMS OTP via Twilio Verify (optional) -----------------------------------
# Used to text login codes when the user picks "Text me a code". Create a
# Verify service in the Twilio console (Verify > Services) and copy its SID.
# When these are unset, codes are printed to the server console instead.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Authenticate with EITHER an API Key (recommended: can be restricted and
# revoked on its own; create one under Account > API keys & tokens) ...
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your-api-key-secret
# ... OR the account Auth Token (used only when no API Key is set).
# TWILIO_AUTH_TOKEN=your-auth-token

# Port the server listens on (most PaaS platforms set this automatically).
PORT=5000

# Set to 0/false in production. Enables Flask's debugger for `python app.py` only.
FLASK_DEBUG=1
