# Copy to .env and fill in real values for local development.
# In production, set these as real environment variables (do NOT commit .env).

# Long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# --- Database ---------------------------------------------------------------
# The app selects its database from DATABASE_URL if set, otherwise it falls
# back to a local SQLite file (DATABASE below).
#
# Postgres (production). Render/Heroku inject DATABASE_URL automatically; the
# app accepts postgres://, postgresql://, or postgresql+psycopg:// forms.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
#
# SQLite (local dev default). Only used when DATABASE_URL is unset.
DATABASE=users.db

# --- Email OTP (optional) ---------------------------------------------------
# Sends login codes when the user picks "Email OTP". The app chooses a transport
# by which vars are set (see send_otp_email in app.py):
#
#   1. Brevo HTTPS API  — set BREVO_API_KEY. Works on hosts that block SMTP
#      (e.g. Render blocks ALL outbound SMTP ports). This is the production path.
#   2. SMTP             — set SMTP_HOST etc. Good for local dev / SMTP-friendly
#      hosts. Gmail needs a 16-char App Password (2-Step Verification required).
#   3. Console print    — none of the above set: the code prints to the server
#      log so local development needs no email account at all.
#
# SMTP_FROM is reused as the sender for BOTH transports. For Brevo it must be a
# verified sender address.
# BREVO_API_KEY=xkeysib-...
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@example.com

# Port the server listens on (most PaaS platforms set this automatically).
PORT=5000

# Set to 0/false in production. Enables Flask's debugger for `python app.py` only.
FLASK_DEBUG=1
